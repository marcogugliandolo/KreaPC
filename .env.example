# Obligatoria: clave de la API de Gemini (https://aistudio.google.com/apikey).
# Se usa con "Grounding with Google Search" para buscar componentes y precios actuales.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Opcional: modelos a usar, en orden de preferencia (si uno no está disponible se prueba el siguiente).
# GEMINI_MODEL="gemini-3.8-flash,gemini-3.6-flash"

# Opcional: puerto del servidor (por defecto 3000).
# PORT=3000

# Opcional: cuántos componentes se buscan en paralelo (por defecto 4).
# PRICE_CONCURRENCY=4

# Opcional: minutos que se guardan en memoria los precios de un componente (por defecto 180).
# PRICE_CACHE_MINUTES=180

# Opcional: límite de consultas por IP y hora (0 = sin límite). Protege los créditos de la API.
# RATE_LIMIT_RECOMMEND_PER_HOUR=15
# RATE_LIMIT_PRICES_PER_HOUR=60
