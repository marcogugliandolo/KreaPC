# KreaPC no necesita claves de API: los precios se leen de las fichas de las tiendas.

# Opcional: puerto del servidor (por defecto 3000).
# PORT=3000

# Opcional: cada cuántas horas se vuelven a leer todos los precios (por defecto 6).
# PRICE_REFRESH_HOURS=6

# Opcional: cada cuántas horas se buscan fichas nuevas en categorías y buscadores (por defecto 24).
# PRICE_DISCOVERY_HOURS=24

# Opcional: horas que se sigue mostrando un precio si la tienda no responde (por defecto 48).
# PRICE_MAX_AGE_HOURS=48

# Opcional: pausa entre peticiones a una misma tienda, en milisegundos (por defecto 1500).
# STORE_DELAY_MS=1500

# Opcional: fichero donde se guardan los precios entre reinicios (por defecto ./data/prices.json).
# PRICES_FILE=./data/prices.json

# Opcional: veces por hora que una IP puede pulsar "Actualizar precios" (0 = sin límite).
# RATE_LIMIT_REFRESH_PER_HOUR=30
